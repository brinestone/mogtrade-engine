{
    "$schema": "https://smithy.io/2.0/_static/smithy-build-schema.json",
    "version": "1.0",
    "outputDirectory": "openapi",
    "sources": [
        "smithy"
    ],
    "maven": {
        "dependencies": [
            "software.amazon.smithy:smithy-aws-traits:1.49.0",
            "software.amazon.smithy:smithy-openapi:1.73.0"
        ]
    },
    "projections": {
        "auth": {
            "plugins": {
                "openapi": {
                    "protocol": "aws.protocols#restJson1",
                    "version": "3.1.0",
                    "service": "mogtrade.auth#Auth",
                    "tags": true
                }
            }
        },
        "economy": {
            "plugins": {
                "openapi": {
                    "protocol": "aws.protocols#restJson1",
                    "version": "3.1.0",
                    "service": "mogtrade.economy#Economy",
                    "tags": true
                }
            }
        }
    }
}