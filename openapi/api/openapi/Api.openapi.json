                "description": "Check whether an email is available for a user to create an account with",
                "operationId": "CheckEmailAvailable",
                "parameters": [
                    {
                        "name": "email",
                        "in": "query",
                        "description": "The email address query",
                        "schema": {
                            "type": "string",
                            "description": "The email address query"
                        },
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CheckEmailAvailable 200 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CheckEmailAvailableResponseContent"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "ValidationError 400 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponseContent"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "InternalServerError 500 response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/InternalServerErrorResponseContent"
                                }
                            }
                        }
                    }
                },
                "security": [],
                "tags": [
                    "Auth"
                ]
            }
        },
