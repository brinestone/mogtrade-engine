    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/app/cmd/main.go"
        },
        {
            "name": "Launch Package",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/app/cmd",
            "envFile": "${workspaceFolder}/app/cmd/.env",
            "cwd": "${workspaceFolder}",
            "output": "${workspaceFolder}/tmp/main",
        }
    ]
}